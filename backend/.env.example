# Core API
KAUSHALWATCH_PERSON_DETECTOR=auto

# Optional OpenVINO detector
KAUSHALWATCH_OPENVINO_MODEL_XML=models/openvino/person-detection-retail-0013/FP16/person-detection-retail-0013.xml
