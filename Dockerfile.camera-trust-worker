FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /srv/kaushalwatch
RUN apt-get update && apt-get install -y --no-install-recommends libglib2.0-0 libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home --shell /usr/sbin/nologin camworker
COPY camera_trust_workstation/requirements-worker.txt ./requirements-worker.txt
RUN pip install --no-cache-dir -r requirements-worker.txt
COPY backend/app ./backend/app
COPY camera_trust_workstation/kwtrust ./camera_trust_workstation/kwtrust
COPY scripts/run_camera_trust_worker.py ./scripts/run_camera_trust_worker.py
RUN mkdir -p /data/camera-media /run/camera-private/references /run/camera-private/auth \
    && chown -R camworker:camworker /data/camera-media
ENV PYTHONPATH=/srv/kaushalwatch/backend:/srv/kaushalwatch
USER camworker
ENTRYPOINT ["python","scripts/run_camera_trust_worker.py"]
