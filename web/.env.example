NEXT_PUBLIC_API_URL=http://localhost:8000

# Protected server-side browser configuration (do not prefix these with NEXT_PUBLIC_).
# Staging retains the current access-key login; production uses OIDC code+PKCE.
# KAUSHALWATCH_WEB_AUTH_MODE=protected
# KAUSHALWATCH_WEB_IDENTITY_MODE=oidc
# KAUSHALWATCH_OIDC_AUTHORIZATION_ENDPOINT=https://login.example.org/oauth2/authorize
# KAUSHALWATCH_OIDC_TOKEN_ENDPOINT=https://login.example.org/oauth2/token
# KAUSHALWATCH_OIDC_REDIRECT_URI=https://kaushalwatch.example.org/api/auth/oidc/callback
# KAUSHALWATCH_OIDC_CLIENT_ID=kaushalwatch-console
# Optional if your provider requires API audience while authorizing:
# KAUSHALWATCH_OIDC_AUTH_AUDIENCE=api://kaushalwatch
# Confidential-client providers may also require KAUSHALWATCH_OIDC_CLIENT_SECRET.
# KAUSHALWATCH_SESSION_STORE=redis-rest
# KAUSHALWATCH_SESSION_REDIS_REST_URL=https://your-private-redis-rest.example.org
# KAUSHALWATCH_SESSION_REDIS_REST_TOKEN=<separate high-entropy credential>
# KAUSHALWATCH_SESSION_ENCRYPTION_KEY=<32-random-bytes-base64>
# KAUSHALWATCH_API_INTERNAL_URL=https://private-api.example.org
