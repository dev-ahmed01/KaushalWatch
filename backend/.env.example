# Core API
KAUSHALWATCH_PERSON_DETECTOR=auto

# Optional OpenVINO detector
KAUSHALWATCH_OPENVINO_MODEL_XML=models/openvino/person-detection-retail-0013/FP16/person-detection-retail-0013.xml
KAUSHALWATCH_OPENVINO_DEVICE=CPU
KAUSHALWATCH_PERSON_CONFIDENCE=0.45
KAUSHALWATCH_OPENVINO_TILED=0
KAUSHALWATCH_OPENVINO_TILE_OVERLAP=0.18
KAUSHALWATCH_OPENVINO_TILE_NMS_IOU=0.45
KAUSHALWATCH_ATTENDANCE_COUNT_SOURCE=registered
KAUSHALWATCH_OCCUPANCY_SMOOTHER_WINDOW=5

# Browser origins allowed to call the API (comma-separated)
KAUSHALWATCH_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Officer review write access — see docs/release/officer-review-access.md
# Development/local SIH walkthrough defaults to demo; pilot/staging/prod must use token.
KAUSHALWATCH_ENV=development
KAUSHALWATCH_REVIEW_AUTH_MODE=demo
# In token mode, provide server-only JSON mapping officer IDs to unique random keys.
# KAUSHALWATCH_REVIEW_TOKENS_JSON={"officer-01":"GENERATE_A_DIFFERENT_HIGH_ENTROPY_SECRET"}

# Kaushal Assistant (backend only; use free-tier keys from Google AI Studio and Groq)
KAUSHAL_AI_ENABLED=true
GEMINI_API_KEY=
GROQ_API_KEY=
KAUSHAL_AI_MODEL=gemini-3.8-flash
KAUSHAL_AI_TIMEOUT_SECONDS=60
KAUSHAL_STT_MODEL=whisper-large-v3-turbo
KAUSHAL_TTS_MODEL=canopylabs/orpheus-v1-english
KAUSHAL_TTS_VOICE=hannah

# Protected officer RBAC: exact actor->role/centre grants (server only).
# Required with token mode for protected sensitive routes.
# See docs/release/centre-scoped-officer-access.md
# KAUSHALWATCH_OFFICER_PERMISSIONS_JSON={"officer-demo":{"role":"centre_reviewer","centres":["DEMO-KA-104"]}}
